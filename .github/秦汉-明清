<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>华夏文明 · 秦汉至明清</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --bg: #1c211d;
      --bg-light: #2e3930;
      --paper: #f4efe5;
      --gold: #d1a15e;
      --gold-light: #e7c789;
      --text: #f4eee1;
      --muted: rgba(244,238,225,.68);
      --line: rgba(255,255,255,.17);
      --panel: rgba(25,30,26,.94);
      --danger: #b56555;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: var(--bg);
      color: var(--text);
      font-family:
        "Noto Serif SC",
        "Songti SC",
        "STSong",
        "Microsoft YaHei",
        serif;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .world {
      width: 100%;
      height: 100%;
      transition: transform .72s cubic-bezier(.76,0,.24,1);
    }

    .hall {
      --mx: 0px;
      --my: 0px;
      position: relative;
      width: 100%;
      height: 100vh;
      min-height: 650px;
      overflow: hidden;
      background:
        radial-gradient(circle at 73% 25%, rgba(210,160,88,.2), transparent 28%),
        linear-gradient(135deg, #38483a, #1c241e 75%);
    }

    .hall[data-dynasty="qinhan"] {
      background:
        radial-gradient(circle at 75% 22%, rgba(202,139,70,.22), transparent 29%),
        linear-gradient(135deg, #4a3523, #211b16 75%);
    }

    .hall[data-dynasty="tangsong"] {
      background:
        radial-gradient(circle at 75% 22%, rgba(80,157,161,.22), transparent 29%),
        linear-gradient(135deg, #304b4d, #1c2829 75%);
    }

    .hall[data-dynasty="mingqing"] {
      background:
        radial-gradient(circle at 75% 22%, rgba(113,158,114,.22), transparent 29%),
        linear-gradient(135deg, #344638, #1c271f 75%);
    }

    .hall::after {
      position: absolute;
      inset: 0;
      content: "";
      pointer-events: none;
      opacity: .4;
      background:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size: 62px 62px;
      mask-image: linear-gradient(to bottom, black, transparent 90%);
    }

    .topbar {
      position: absolute;
      top: 25px;
      right: 32px;
      left: 32px;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .museum-title {
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgba(255,255,255,.85);
      font-size: 13px;
      letter-spacing: .12em;
    }

    .seal {
      display: grid;
      place-items: center;
      width: 35px;
      height: 35px;
      color: #2f2112;
      background: var(--gold-light);
      border-radius: 50%;
      font-size: 15px;
      font-weight: 700;
    }

    .counter {
      padding: 8px 12px;
      color: rgba(255,255,255,.7);
      background: rgba(0,0,0,.25);
      border: 1px solid var(--line);
      border-radius: 3px;
      font-family: system-ui, sans-serif;
      font-size: 11px;
      letter-spacing: .13em;
    }

    .hall-copy {
      position: absolute;
      top: 17%;
      left: 8%;
      z-index: 4;
      width: min(430px, 38%);
      pointer-events: none;
      transform: translate3d(var(--mx), var(--my), 0);
      transition: transform .18s ease-out;
    }

    .hall-index {
      display: block;
      margin-bottom: 16px;
      color: var(--gold-light);
      font-family: system-ui, sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .2em;
    }

    .hall-copy h1 {
      margin: 0 0 16px;
      color: #f4ebdc;
      font-size: clamp(40px, 5.5vw, 82px);
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: .08em;
      text-shadow: 0 4px 25px rgba(0,0,0,.3);
    }

    .hall-copy h2 {
      margin: 0 0 18px;
      color: var(--gold-light);
      font-size: clamp(16px, 1.7vw, 24px);
      font-weight: 500;
      letter-spacing: .08em;
    }

    .hall-copy p {
      max-width: 370px;
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 2;
    }

    .gold-line {
      width: 70px;
      height: 2px;
      margin-top: 24px;
      background: var(--gold-light);
    }

    .artifact-zone {
      position: absolute;
      top: 13%;
      right: 8%;
      bottom: 8%;
      width: 51%;
      min-width: 420px;
      transform: translate3d(calc(var(--mx) * -.45), calc(var(--my) * -.45), 0);
      transition: transform .18s ease-out;
    }

    .artifact-light {
      position: absolute;
      top: -3%;
      right: 12%;
      width: 72%;
      height: 93%;
      background: radial-gradient(ellipse, rgba(240,202,136,.4), transparent 68%);
      filter: blur(25px);
      opacity: .58;
    }

    .artifact-stage {
      position: absolute;
      inset: 10% 4% 4%;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1200px;
    }

    .artifact-frame {
      position: relative;
      width: min(650px, 92%);
      padding: 18px;
      background: linear-gradient(145deg, #e0c188, #8b673d);
      border: 1px solid rgba(255,255,255,.25);
      box-shadow:
        0 28px 75px rgba(0,0,0,.46),
        0 0 0 12px rgba(0,0,0,.3),
        0 0 0 13px rgba(206,163,96,.32);
      transform: rotateY(-7deg) rotateX(2deg);
      transition: transform .3s ease;
    }

    .artifact-frame:hover {
      transform: rotateY(-1deg) rotateX(0) translateY(-6px);
    }

    .media-box {
      position: relative;
      width: 100%;
      min-height: 360px;
      overflow: hidden;
      background: #101211;
      border: 1px solid rgba(0,0,0,.4);
    }

    .media-box img,
    .media-box video {
      display: block;
      width: 100%;
      height: min(58vh, 610px);
      object-fit: contain;
      background: #101211;
    }

    .media-box video {
      object-fit: contain;
    }

    .media-tools {
      position: absolute;
      top: 13px;
      right: 13px;
      z-index: 8;
      display: flex;
      gap: 8px;
    }

    .tool {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      color: #fff;
      background: rgba(0,0,0,.58);
      border: 1px solid rgba(255,255,255,.28);
      border-radius: 50%;
      font-family: system-ui, sans-serif;
      font-size: 14px;
    }

    .tool:hover {
      color: #271b0c;
      background: var(--gold-light);
    }

    .artifact-caption {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 5px 0;
      color: #2a2015;
    }

    .artifact-caption strong {
      display: block;
      margin-bottom: 4px;
      font-size: 17px;
      font-weight: 500;
    }

    .artifact-caption small {
      color: rgba(42,32,21,.65);
      font-family: system-ui, sans-serif;
      font-size: 10px;
    }

    .hotspot {
      position: absolute;
      z-index: 12;
      width: 26px;
      height: 26px;
      padding: 0;
      color: #2b1e0d;
      background: var(--gold-light);
      border: 2px solid #fff;
      border-radius: 50%;
      box-shadow: 0 0 0 6px rgba(225,189,126,.23);
      transform: translate(-50%, -50%);
      animation: pulse 2.2s infinite;
    }

    .hotspot:hover {
      animation: none;
      background: #fff3d2;
    }

    @keyframes pulse {
      0%,100% {
        box-shadow: 0 0 0 5px rgba(225,189,126,.2);
      }

      50% {
        box-shadow: 0 0 0 12px rgba(225,189,126,0);
      }
    }

    .help {
      position: absolute;
      bottom: 28px;
      left: 8%;
      z-index: 6;
      color: rgba(255,255,255,.55);
      font-family: system-ui, sans-serif;
      font-size: 11px;
    }

    .side-nav {
      position: fixed;
      top: 50%;
      right: 28px;
      z-index: 30;
      display: grid;
      gap: 13px;
      transform: translateY(-50%);
    }

    .nav-dot {
      width: 10px;
      height: 10px;
      padding: 0;
      background: rgba(255,255,255,.3);
      border: 0;
      border-radius: 50%;
    }

    .nav-dot.active {
      background: var(--gold-light);
      box-shadow: 0 0 0 6px rgba(225,189,126,.18);
    }

    .nav-dot span {
      position: absolute;
      right: 22px;
      color: #fff;
      font-family: system-ui, sans-serif;
      font-size: 11px;
      opacity: 0;
      transform: translateX(6px);
      transition: .2s ease;
      pointer-events: none;
    }

    .nav-dot:hover span {
      opacity: 1;
      transform: translateX(0);
    }

    .detail-panel {
      position: fixed;
      right: 34px;
      bottom: 34px;
      z-index: 40;
      width: min(440px, calc(100% - 40px));
      min-height: 190px;
      padding: 27px 29px;
      color: #fff;
      background: rgba(23,28,24,.95);
      border: 1px solid rgba(225,189,126,.7);
      border-radius: 4px;
      box-shadow: 0 25px 70px rgba(0,0,0,.35);
      backdrop-filter: blur(14px);
      opacity: 0;
      transform: translateY(15px);
      pointer-events: none;
      transition: .25s ease;
    }

    .detail-panel.show {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .detail-panel small {
      display: block;
      margin-bottom: 10px;
      color: var(--gold-light);
      font-family: system-ui, sans-serif;
      font-size: 10px;
      letter-spacing: .16em;
    }

    .detail-panel h3 {
      margin: 0 0 12px;
      font-size: 25px;
      font-weight: 500;
    }

    .detail-panel p {
      margin: 0;
      color: rgba(255,255,255,.75);
      font-size: 15px;
      line-height: 2;
    }

    .close {
      position: absolute;
      top: 9px;
      right: 10px;
      width: 28px;
      height: 28px;
      color: rgba(255,255,255,.7);
      background: transparent;
      border: 0;
      font-size: 20px;
    }

    .edit-toggle {
      position: fixed;
      right: 20px;
      bottom: 19px;
      z-index: 45;
      padding: 9px 12px;
      color: rgba(255,255,255,.8);
      background: rgba(0,0,0,.42);
      border: 1px solid rgba(255,255,255,.24);
      border-radius: 3px;
      font-family: system-ui, sans-serif;
      font-size: 11px;
    }

    .editor {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 80;
      width: min(430px, 100%);
      padding: 25px 22px;
      overflow-y: auto;
      color: #29261f;
      background: var(--paper);
      box-shadow: -20px 0 70px rgba(0,0,0,.3);
      transform: translateX(100%);
      transition: transform .35s ease;
    }

    .editor.open {
      transform: translateX(0);
    }

    .editor h2 {
      margin: 0 0 7px;
      font-size: 25px;
      font-weight: 500;
    }

    .editor > p {
      margin: 0 0 22px;
      color: #7c766c;
      font-size: 12px;
      line-height: 1.8;
    }

    .editor-close {
      position: absolute;
      top: 15px;
      right: 15px;
      width: 32px;
      height: 32px;
      color: #777066;
      background: transparent;
      border: 0;
      font-size: 21px;
    }

    .field {
      margin-bottom: 12px;
    }

    .field label {
      display: block;
      margin-bottom: 6px;
      color: #81786c;
      font-size: 11px;
    }

    .field input,
    .field textarea,
    .field select {
      width: 100%;
      padding: 10px;
      color: #29261f;
      background: #fff;
      border: 1px solid #d8cec0;
      border-radius: 3px;
      outline: none;
    }

    .field textarea {
      min-height: 80px;
      resize: vertical;
    }

    .media-editor {
      margin-top: 18px;
      padding-top: 17px;
      border-top: 1px solid #d8cec0;
    }

    .media-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
    }

    .media-head strong {
      font-size: 13px;
    }

    .media-head button,
    .small-button {
      padding: 6px 8px;
      color: #765234;
      background: #f7ead9;
      border: 1px solid #d7b184;
      border-radius: 3px;
      font-size: 11px;
    }

    .editor-preview {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 150px;
      overflow: hidden;
      background: #e4ddd2;
      border: 1px dashed #cdbda7;
    }

    .editor-preview img,
    .editor-preview video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #171817;
    }

    .hotspot-list {
      display: grid;
      gap: 9px;
      margin-top: 11px;
    }

    .hotspot-row {
      padding: 10px;
      background: #ebe3d7;
      border: 1px solid #d7cabb;
      border-radius: 3px;
    }

    .hotspot-row input,
    .hotspot-row textarea {
      width: 100%;
      margin-bottom: 6px;
      padding: 7px;
      color: #29261f;
      background: #fff;
      border: 1px solid #d6cabc;
      border-radius: 3px;
      font-size: 11px;
    }

    .hotspot-row textarea {
      min-height: 55px;
      resize: vertical;
    }

    .coordinate-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }

    .editor-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 18px;
    }

    .editor-button {
      min-height: 40px;
      padding: 9px;
      color: #29261f;
      background: #fff;
      border: 1px solid #d8cec0;
      border-radius: 3px;
    }

    .editor-button.primary {
      color: #fff;
      background: #a96e3c;
      border-color: #a96e3c;
    }

    .editor-tip {
      margin-top: 15px;
      padding: 11px;
      color: #776f64;
      background: #e9e0d4;
      border-left: 3px solid var(--gold);
      font-size: 11px;
      line-height: 1.8;
    }

    .viewer {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 25px;
      align-items: center;
      padding: 40px;
      background: rgba(7,9,8,.96);
      opacity: 0;
      pointer-events: none;
      transition: opacity .25s ease;
    }

    .viewer.show {
      opacity: 1;
      pointer-events: auto;
    }

    .viewer-content {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: min(86vh, 900px);
      overflow: hidden;
    }

    .viewer-content img,
    .viewer-content video {
      display: block;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      background: #050605;
      box-shadow: 0 30px 90px rgba(0,0,0,.45);
    }

    .viewer-content video {
      width: 100%;
    }

    .viewer-hotspot {
      position: absolute;
      width: 28px;
      height: 28px;
      padding: 0;
      color: #241a0d;
      background: var(--gold-light);
      border: 2px solid #fff;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      box-shadow: 0 0 0 7px rgba(225,189,126,.22);
    }

    .viewer-detail {
      position: relative;
      min-height: 240px;
      padding: 27px;
      color: #fff;
      background: rgba(28,34,29,.95);
      border: 1px solid rgba(225,189,126,.68);
      border-radius: 4px;
    }

    .viewer-detail small {
      color: var(--gold-light);
      font-family: system-ui, sans-serif;
      font-size: 10px;
      letter-spacing: .16em;
    }

    .viewer-detail h3 {
      margin: 15px 0 12px;
      font-size: 26px;
      font-weight: 500;
    }

    .viewer-detail p {
      color: rgba(255,255,255,.74);
      font-size: 14px;
      line-height: 2;
    }

    .viewer-close {
      position: absolute;
      top: 19px;
      right: 22px;
      z-index: 3;
      width: 40px;
      height: 40px;
      color: #fff;
      background: rgba(0,0,0,.4);
      border: 1px solid rgba(255,255,255,.3);
      border-radius: 50%;
      font-size: 23px;
    }

    .viewer-fullscreen {
      position: absolute;
      right: 22px;
      bottom: 20px;
      z-index: 3;
      padding: 9px 12px;
      color: #fff;
      background: rgba(0,0,0,.48);
      border: 1px solid rgba(255,255,255,.3);
      border-radius: 3px;
      font-size: 11px;
    }

    .transition {
      position: fixed;
      inset: 0;
      z-index: 150;
      display: grid;
      place-items: center;
      background:
        linear-gradient(
          105deg,
          transparent 0 35%,
          rgba(214,169,94,.9) 48%,
          rgba(54,38,21,.96) 54%,
          transparent 68%
        );
      opacity: 0;
      pointer-events: none;
      transform: translateX(-115%);
    }

    .transition.active {
      animation: transitionSweep .72s cubic-bezier(.7,0,.3,1) both;
    }

    .transition span {
      padding: 13px 20px;
      color: var(--gold-light);
      border: 1px solid rgba(225,189,126,.7);
      border-radius: 50%;
      background: rgba(41,29,16,.45);
      font-size: 24px;
      letter-spacing: .18em;
      transform: rotate(-8deg);
    }

    @keyframes transitionSweep {
      0% {
        opacity: 0;
        transform: translateX(-115%);
      }

      25% {
        opacity: 1;
      }

      72% {
        opacity: 1;
      }

      100% {
        opacity: 0;
        transform: translateX(115%);
      }
    }

    @media (max-width: 800px) {
      .hall-copy {
        top: 12%;
        left: 18px;
        width: 44%;
      }

      .hall-copy h1 {
        font-size: 42px;
      }

      .hall-copy p {
        font-size: 12px;
        line-height: 1.75;
      }

      .artifact-zone {
        right: 3%;
        width: 57%;
        min-width: 0;
      }

      .viewer {
        grid-template-columns: 1fr;
        gap: 12px;
        padding: 20px;
      }

      .viewer-content {
        height: 64vh;
      }

      .viewer-detail {
        min-height: 130px;
        padding: 18px;
      }

      .viewer-detail h3 {
        margin: 8px 0;
        font-size: 20px;
      }

      .viewer-detail p {
        margin: 0;
        font-size: 12px;
        line-height: 1.7;
      }
    }

    @media (max-width: 560px) {
      .topbar {
        top: 14px;
        right: 15px;
        left: 15px;
      }

      .museum-title {
        font-size: 10px;
      }

      .hall-copy {
        top: 10%;
        left: 18px;
        width: calc(100% - 36px);
      }

      .hall-copy h1 {
        margin-bottom: 8px;
        font-size: 36px;
      }

      .hall-copy h2 {
        margin-bottom: 9px;
        font-size: 15px;
      }

      .hall-copy p {
        max-width: 305px;
        font-size: 11px;
      }

      .artifact-zone {
        top: 39%;
        right: 4%;
        bottom: 8%;
        left: 4%;
        width: auto;
      }

      .artifact-stage {
        inset: 0;
      }

      .artifact-frame {
        width: 94%;
        padding: 11px;
      }

      .media-box {
        min-height: 260px;
      }

      .media-box img,
      .media-box video {
        height: 42vh;
      }

      .side-nav {
        top: auto;
        right: auto;
        bottom: 24px;
        left: 50%;
        display: flex;
        transform: translateX(-50%);
      }

      .help {
        display: none;
      }

      .detail-panel {
        right: 16px;
        bottom: 57px;
        width: calc(100% - 32px);
      }

      .viewer {
        padding: 13px;
      }
    }
  </style>
</head>

<body>
  <main class="app">
    <div id="world" class="world"></div>

    <nav id="side-nav" class="side-nav"></nav>

    <section id="detail-panel" class="detail-panel">
      <button id="close-detail" class="close">×</button>
      <small id="detail-label">局部说明</small>
      <h3 id="detail-title">点击图片中的热点</h3>
      <p id="detail-text">这里会显示展品的局部说明。</p>
    </section>

    <button id="edit-toggle" class="edit-toggle">编辑当前展厅</button>

    <aside id="editor" class="editor">
      <button id="editor-close" class="editor-close">×</button>

      <h2>展厅编辑</h2>
      <p>
        上传图片或视频后保存。图片不压缩，视频直接保存到 Supabase Storage。
      </p>

      <div class="field">
        <label>展厅标题</label>
        <input id="hall-title" />
      </div>

      <div class="field">
        <label>展厅副标题</label>
        <input id="hall-subtitle" />
      </div>

      <div class="field">
        <label>展厅介绍</label>
        <textarea id="hall-description"></textarea>
      </div>

      <div id="media-editors"></div>

      <div class="editor-actions">
        <button id="add-media" class="editor-button">
          添加图片 / 视频
        </button>

        <button id="save" class="editor-button primary">
          保存到云端
        </button>
      </div>

      <div class="editor-tip">
        编辑热点时，点击展厅中的图片可以添加热点。热点位置、标题和说明文字都可以继续修改。
        所有设备访问同一个网页时，会读取同一份 Supabase 数据。
      </div>
    </aside>

    <section id="viewer" class="viewer">
      <button id="viewer-close" class="viewer-close">×</button>

      <div id="viewer-content" class="viewer-content"></div>

      <div id="viewer-detail" class="viewer-detail">
        <small>局部说明</small>
        <h3 id="viewer-title">点击图片热点</h3>
        <p id="viewer-text">点击图片上的标记查看局部说明。</p>
      </div>

      <button id="viewer-fullscreen" class="viewer-fullscreen">
        浏览器全屏
      </button>
    </section>

    <div id="transition" class="transition">
      <span id="transition-text">秦汉 → 唐宋</span>
    </div>
  </main>

  <script>
    const SUPABASE_URL =
      "https://htdkyyggwsnsigrpclae.supabase.co";

    const SUPABASE_ANON_KEY =
      "sb_publishable_Ui-qf5Rom0fohPJUzBOMug_Fe8f_Nrc";

    const BUCKET = "111";

    const supabaseClient = window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_ANON_KEY
    );

    let halls = [];
    let currentHallIndex = 0;
    let currentMediaId = null;
    let pendingFiles = new Map();
    let lastWheel = 0;

    const world = document.querySelector("#world");
    const sideNav = document.querySelector("#side-nav");
    const detailPanel = document.querySelector("#detail-panel");
    const editor = document.querySelector("#editor");
    const mediaEditors = document.querySelector("#media-editors");
    const viewer = document.querySelector("#viewer");
    const viewerContent = document.querySelector("#viewer-content");

    window.addEventListener("DOMContentLoaded", init);

    async function init() {
      try {
        await loadData();
        renderWorld();
        renderNav();
        renderEditor();
        updateHallPosition();
      } catch (error) {
        console.error(error);
        alert("展厅读取失败，请检查 Supabase 表、Bucket 和权限策略。");
      }

      bindEvents();
    }

    async function loadData() {
      const { data: hallData, error: hallError } =
        await supabaseClient
          .from("museum_halls")
          .select("*")
          .order("sort_order");

      if (hallError) {
        throw hallError;
      }

      const { data: mediaData, error: mediaError } =
        await supabaseClient
          .from("museum_media")
          .select("*")
          .order("sort_order");

      if (mediaError) {
        throw mediaError;
      }

      halls = hallData.map(hall => ({
        ...hall,
        media: mediaData.filter(item => item.hall_id === hall.id)
      }));
    }

    function renderWorld() {
      world.innerHTML = "";

      halls.forEach((hall, hallIndex) => {
        const section = document.createElement("section");

        section.className = "hall";
        section.dataset.dynasty = hall.id;

        section.innerHTML = `
          <header class="topbar">
            <div class="museum-title">
              <span class="seal">华</span>
              <span>华夏文明 · 秦汉至明清</span>
            </div>

            <div class="counter">
              ${String(hallIndex + 1).padStart(2, "0")} / ${String(halls.length).padStart(2, "0")}
            </div>
          </header>

          <div class="hall-copy">
            <span class="hall-index">
              HALL ${String(hallIndex + 1).padStart(2, "0")} · ${escapeHtml(hall.dynasty)}
            </span>

            <h1>${escapeHtml(hall.dynasty)}</h1>
            <h2>${escapeHtml(hall.title)}</h2>
            <p>${escapeHtml(hall.description)}</p>
            <div class="gold-line"></div>
          </div>

          <div class="artifact-zone">
            <div class="artifact-light"></div>

            <div class="artifact-stage">
              <div class="artifact-frame">
                <div class="media-box">
                  <div class="media-tools">
                    <button class="tool fullscreen-button">⛶</button>
                  </div>

                  <div class="media-mount"></div>
                </div>

                <div class="artifact-caption">
                  <div>
                    <strong class="artifact-title"></strong>
                    <small>${escapeHtml(hall.dynasty)} · 线上重点展品</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="help">
            滚轮切换展厅 · 双击放大 · 点击热点查看局部说明
          </div>
        `;

        world.appendChild(section);
        renderHallMedia(section, hall);
      });
    }

    function renderHallMedia(section, hall) {
      const mount = section.querySelector(".media-mount");
      const title = section.querySelector(".artifact-title");
      const media = hall.media[0];

      mount.innerHTML = "";

      if (!media) {
        mount.innerHTML = `
          <div style="
            display:grid;
            place-items:center;
            height:360px;
            color:rgba(255,255,255,.55);
            font-size:13px;
          ">
            请在编辑面板上传第一件展品
          </div>
        `;
        return;
      }

      title.textContent = media.title || hall.title;

      const element = createMediaElement(media, false);

      mount.appendChild(element);

      if (media.media_type === "image") {
        renderHotspots(mount, media, false);
      }

      section
        .querySelector(".fullscreen-button")
        .addEventListener("click", () => {
          openViewer(media);
        });
    }

    function createMediaElement(media, viewerMode) {
      if (media.media_type === "video") {
        const video = document.createElement("video");

        video.src = media.media_url;
        video.controls = true;
        video.preload = "metadata";
        video.playsInline = true;
        video.setAttribute("playsinline", "");
        video.setAttribute("webkit-playsinline", "");
        video.addEventListener("dblclick", () => openViewer(media));

        return video;
      }

      const image = document.createElement("img");

      image.src = media.media_url;
      image.alt = media.title || "展品图片";
      image.draggable = false;

      image.addEventListener("dblclick", () => {
        openViewer(media);
      });

      if (!viewerMode) {
        image.addEventListener("click", event => {
          selectNearestHotspot(event, image, media);
        });
      }

      return image;
    }

    function renderHotspots(container, media, viewerMode) {
      if (!Array.isArray(media.hotspots)) {
        return;
      }

      media.hotspots.forEach(hotspot => {
        const button = document.createElement("button");

        button.className = viewerMode ? "viewer-hotspot" : "hotspot";
        button.style.left = `${hotspot.x}%`;
        button.style.top = `${hotspot.y}%`;
        button.textContent = "+";
        button.title = hotspot.title || "局部说明";

        button.addEventListener("click", event => {
          event.stopPropagation();
          showDetail(media, hotspot);
        });

        container.appendChild(button);
      });
    }

    function selectNearestHotspot(event, image, media) {
      if (!media.hotspots?.length) {
        return;
      }

      const rect = image.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;

      let nearest = null;
      let distance = Infinity;

      media.hotspots.forEach(item => {
        const currentDistance = Math.sqrt(
          Math.pow(item.x - x, 2) + Math.pow(item.y - y, 2)
        );

        if (currentDistance < distance) {
          distance = currentDistance;
          nearest = item;
        }
      });

      if (nearest && distance < 17) {
        showDetail(media, nearest);
      }
    }

    function showDetail(media, hotspot) {
      detailPanel.classList.add("show");
      document.querySelector("#detail-label").textContent =
        media.title || "局部说明";
      document.querySelector("#detail-title").textContent =
        hotspot.title || "未命名区域";
      document.querySelector("#detail-text").textContent =
        hotspot.text || "暂无说明";
    }

    function renderNav() {
      sideNav.innerHTML = "";

      halls.forEach((hall, index) => {
        const button = document.createElement("button");

        button.className = "nav-dot";
        button.dataset.index = index;
        button.innerHTML = `<span>${escapeHtml(hall.dynasty)}</span>`;

        button.addEventListener("click", () => {
          goToHall(index);
        });

        sideNav.appendChild(button);
      });

      updateHallPosition();
    }

    function updateHallPosition() {
      world.style.transform =
        `translateY(-${currentHallIndex * 100}vh)`;

      document.querySelectorAll(".nav-dot").forEach((button, index) => {
        button.classList.toggle(
          "active",
          index === currentHallIndex
        );
      });
    }

    function goToHall(index) {
      if (
        index < 0 ||
        index >= halls.length ||
        index === currentHallIndex
      ) {
        return;
      }

      const oldHall = halls[currentHallIndex];
      const newHall = halls[index];

      currentHallIndex = index;
      playTransition(oldHall.dynasty, newHall.dynasty);
      updateHallPosition();
      renderEditor();
      closeDetail();
    }

    function playTransition(oldName, newName) {
      const transition = document.querySelector("#transition");
      const text = document.querySelector("#transition-text");

      text.textContent = `${oldName}  →  ${newName}`;
      transition.classList.remove("active");

      void transition.offsetWidth;

      transition.classList.add("active");
    }

    function bindEvents() {
      window.addEventListener("wheel", event => {
        const now = Date.now();

        if (now - lastWheel < 700) {
          return;
        }

        lastWheel = now;

        if (event.deltaY > 0) {
          goToHall(Math.min(currentHallIndex + 1, halls.length - 1));
        } else {
          goToHall(Math.max(currentHallIndex - 1, 0));
        }
      }, { passive: true });

      window.addEventListener("keydown", event => {
        if (event.key === "ArrowDown") {
          goToHall(Math.min(currentHallIndex + 1, halls.length - 1));
        }

        if (event.key === "ArrowUp") {
          goToHall(Math.max(currentHallIndex - 1, 0));
        }

        if (event.key === "Escape") {
          closeViewer();
          closeDetail();
          editor.classList.remove("open");
        }
      });

      window.addEventListener("pointermove", event => {
        const hall = document.querySelectorAll(".hall")[currentHallIndex];

        if (!hall) {
          return;
        }

        const x = (event.clientX / innerWidth - .5) * 12;
        const y = (event.clientY / innerHeight - .5) * 8;

        hall.style.setProperty("--mx", `${x}px`);
        hall.style.setProperty("--my", `${y}px`);
      });

      document.querySelector("#close-detail")
        .addEventListener("click", closeDetail);

      document.querySelector("#edit-toggle")
        .addEventListener("click", () => {
          editor.classList.add("open");
        });

      document.querySelector("#editor-close")
        .addEventListener("click", () => {
          editor.classList.remove("open");
        });

      document.querySelector("#add-media")
        .addEventListener("click", addMediaEditor);

      document.querySelector("#save")
        .addEventListener("click", saveHall);

      document.querySelector("#viewer-close")
        .addEventListener("click", closeViewer);

      document.querySelector("#viewer-fullscreen")
        .addEventListener("click", async () => {
          if (!document.fullscreenElement) {
            await viewer.requestFullscreen?.();
          } else {
            await document.exitFullscreen?.();
          }
        });
    }

    function renderEditor() {
      const hall = halls[currentHallIndex];

      document.querySelector("#hall-title").value = hall.title;
      document.querySelector("#hall-subtitle").value = hall.subtitle;
      document.querySelector("#hall-description").value = hall.description;

      mediaEditors.innerHTML = "";

      hall.media.forEach(media => {
        mediaEditors.appendChild(createMediaEditor(media));
      });
    }

    function createMediaEditor(media) {
      const wrapper = document.createElement("div");

      wrapper.className = "media-editor";
      wrapper.dataset.mediaId = media.id;

      wrapper.innerHTML = `
        <div class="media-head">
          <strong>
            ${media.media_type === "video" ? "视频" : "图片"} · ${escapeHtml(media.title || "未命名展品")}
          </strong>

          <button class="remove-media">删除</button>
        </div>

        <div class="editor-preview"></div>

        <div class="field">
          <label>展品名称</label>
          <input class="media-title" value="${escapeAttr(media.title || "")}" />
        </div>

        <div class="field">
          <label>展品说明</label>
          <textarea class="media-description">${escapeHtml(media.description || "")}</textarea>
        </div>

        <label class="small-button">
          更换文件
          <input class="replace-file" type="file" accept="image/*,video/*" hidden />
        </label>

        <div class="hotspot-list"></div>

        <button class="small-button add-hotspot">
          新增局部说明
        </button>
      `;

      const preview = wrapper.querySelector(".editor-preview");

      if (media.media_type === "video") {
        const video = document.createElement("video");

        video.src = media.media_url;
        video.controls = true;
        video.preload = "metadata";
        preview.appendChild(video);
      } else {
        const image = document.createElement("img");

        image.src = media.media_url;
        image.alt = media.title || "图片";
        preview.appendChild(image);
      }

      const hotspotList = wrapper.querySelector(".hotspot-list");

      (media.hotspots || []).forEach((hotspot, index) => {
        hotspotList.appendChild(
          createHotspotEditor(media, hotspot, index)
        );
      });

      wrapper.querySelector(".remove-media")
        .addEventListener("click", async () => {
          if (!confirm("确定删除这件媒体展品吗？")) {
            return;
          }

          const { error } = await supabaseClient
            .from("museum_media")
            .delete()
            .eq("id", media.id);

          if (error) {
            alert(error.message);
            return;
          }

          await loadData();
          renderWorld();
          renderEditor();
        });

      wrapper.querySelector(".replace-file")
        .addEventListener("change", event => {
          const file = event.target.files[0];

          if (!file) {
            return;
          }

          pendingFiles.set(media.id, file);

          const previewUrl = URL.createObjectURL(file);
          preview.innerHTML = "";

          if (file.type.startsWith("video/")) {
            const video = document.createElement("video");

            video.src = previewUrl;
            video.controls = true;
            preview.appendChild(video);
          } else {
            const image = document.createElement("img");

            image.src = previewUrl;
            preview.appendChild(image);
          }
        });

      wrapper.querySelector(".add-hotspot")
        .addEventListener("click", async () => {
          if (media.media_type !== "image") {
            alert("视频不设置图片热点。");
            return;
          }

          const title = prompt("请输入局部标题：", "新的局部说明");

          if (!title) {
            return;
          }

          const text = prompt("请输入局部说明：", "请填写这部分内容。");

          if (text === null) {
            return;
          }

          const hotspots = Array.isArray(media.hotspots)
            ? media.hotspots
            : [];

          hotspots.push({
            x: 50,
            y: 50,
            title,
            text
          });

          await updateHotspots(media.id, hotspots);
        });

      return wrapper;
    }

    function createHotspotEditor(media, hotspot, index) {
      const row = document.createElement("div");

      row.className = "hotspot-row";

      row.innerHTML = `
        <input class="hotspot-title" value="${escapeAttr(hotspot.title || "")}" />
        <div class="coordinate-row">
          <input class="hotspot-x" type="number" min="0" max="100" value="${hotspot.x}" />
          <input class="hotspot-y" type="number" min="0" max="100" value="${hotspot.y}" />
        </div>
        <textarea class="hotspot-text">${escapeHtml(hotspot.text || "")}</textarea>
        <button class="small-button delete-hotspot">删除局部说明</button>
      `;

      const save = async () => {
        const current = getMediaById(media.id);

        if (!current) {
          return;
        }

        const hotspots = [...(current.hotspots || [])];

        hotspots[index] = {
          title: row.querySelector(".hotspot-title").value,
          x: Number(row.querySelector(".hotspot-x").value),
          y: Number(row.querySelector(".hotspot-y").value),
          text: row.querySelector(".hotspot-text").value
        };

        await updateHotspots(media.id, hotspots);
      };

      row.querySelectorAll("input, textarea")
        .forEach(input => {
          input.addEventListener("change", save);
        });

      row.querySelector(".delete-hotspot")
        .addEventListener("click", async () => {
          const current = getMediaById(media.id);
          const hotspots = [...(current.hotspots || [])];

          hotspots.splice(index, 1);

          await updateHotspots(media.id, hotspots);
        });

      return row;
    }

    function getMediaById(id) {
      const hall = halls[currentHallIndex];

      return hall.media.find(media => media.id === id);
    }

    async function updateHotspots(mediaId, hotspots) {
      const { error } = await supabaseClient
        .from("museum_media")
        .update({ hotspots })
        .eq("id", mediaId);

      if (error) {
        alert(error.message);
        return;
      }

      await loadData();
      renderWorld();
      renderEditor();
    }

    function addMediaEditor() {
      const input = document.createElement("input");

      input.type = "file";
      input.accept = "image/*,video/*";
      input.multiple = true;

      input.addEventListener("change", event => {
        const files = [...event.target.files];

        files.forEach(file => {
          pendingFiles.set(`new-${cryptoRandom()}`, file);
        });

        alert(
          `已选择 ${files.length} 个文件。点击“保存到云端”后会上传。`
        );
      });

      input.click();

      input.addEventListener("change", () => {
        renderEditorPendingFiles();
      });
    }

    function renderEditorPendingFiles() {
      const pending = [...pendingFiles.entries()]
        .filter(([key]) => key.startsWith("new-"));

      if (!pending.length) {
        return;
      }

      const box = document.createElement("div");

      box.className = "media-editor";
      box.innerHTML = `
        <div class="media-head">
          <strong>待上传媒体</strong>
        </div>
        <p style="color:#7d7469;font-size:11px;">
          ${pending.length} 个文件将在保存时上传到 Supabase。
        </p>
      `;

      mediaEditors.appendChild(box);
    }

    async function saveHall() {
      const hall = halls[currentHallIndex];

      const hallUpdate = {
        title: document.querySelector("#hall-title").value.trim(),
        subtitle: document.querySelector("#hall-subtitle").value.trim(),
        description: document.querySelector("#hall-description").value.trim(),
        updated_at: new Date().toISOString()
      };

      const { error: hallError } = await supabaseClient
        .from("museum_halls")
        .update(hallUpdate)
        .eq("id", hall.id);

      if (hallError) {
        alert(hallError.message);
        return;
      }

      const editorItems = [
        ...mediaEditors.querySelectorAll(".media-editor[data-media-id]")
      ];

      for (const editorItem of editorItems) {
        const mediaId = editorItem.dataset.mediaId;
        const media = getMediaById(mediaId);

        if (!media) {
          continue;
        }

        const title = editorItem.querySelector(".media-title").value;
        const description =
          editorItem.querySelector(".media-description").value;

        await supabaseClient
          .from("museum_media")
          .update({
            title,
            description
          })
          .eq("id", mediaId);

        const replacement = pendingFiles.get(mediaId);

        if (replacement) {
          const path = makeStoragePath(hall.id, mediaId, replacement);

          const upload = await supabaseClient.storage
            .from(BUCKET)
            .upload(path, replacement, {
              upsert: true,
              contentType: replacement.type,
              cacheControl: "3600"
            });

          if (upload.error) {
            alert(upload.error.message);
            continue;
          }

          const publicUrl =
            `${SUPABASE_URL}/storage/v1/object/public/${BUCKET}/${path}`;

          await supabaseClient
            .from("museum_media")
            .update({
              media_type: replacement.type.startsWith("video/")
                ? "video"
                : "image",
              media_url: publicUrl,
              storage_path: path
            })
            .eq("id", mediaId);

          pendingFiles.delete(mediaId);
        }
      }

      const newFiles = [...pendingFiles.entries()]
        .filter(([key]) => key.startsWith("new-"));

      for (const [, file] of newFiles) {
        const mediaId = cryptoRandom();
        const path = makeStoragePath(hall.id, mediaId, file);

        const upload = await supabaseClient.storage
          .from(BUCKET)
          .upload(path, file, {
            upsert: true,
            contentType: file.type,
            cacheControl: "3600"
          });

        if (upload.error) {
          alert(upload.error.message);
          continue;
        }

        const publicUrl =
          `${SUPABASE_URL}/storage/v1/object/public/${BUCKET}/${path}`;

        const { error } = await supabaseClient
          .from("museum_media")
          .insert({
            id: mediaId,
            hall_id: hall.id,
            media_type: file.type.startsWith("video/")
              ? "video"
              : "image",
            media_url: publicUrl,
            storage_path: path,
            title: file.name,
            description: "",
            sort_order: hall.media.length
          });

        if (error) {
          alert(error.message);
        }

        pendingFiles.delete(`new-${mediaId}`);
      }

      await loadData();
      renderWorld();
      renderNav();
      renderEditor();
      editor.classList.remove("open");

      alert("展厅已经保存到云端。");
    }

    function openViewer(media) {
      viewerContent.innerHTML = "";

      const element = createMediaElement(media, true);

      viewerContent.appendChild(element);

      if (media.media_type === "image") {
        renderHotspots(viewerContent, media, true);
      }

      viewer.classList.add("show");
    }

    function closeViewer() {
      viewer.classList.remove("show");
      viewerContent.innerHTML = "";
    }

    function closeDetail() {
      detailPanel.classList.remove("show");
    }

    function makeStoragePath(hallId, mediaId, file) {
      const extension = file.name.includes(".")
        ? file.name.split(".").pop().toLowerCase()
        : "bin";

      return `halls/${hallId}/${mediaId}.${extension}`;
    }

    function cryptoRandom() {
      if (window.crypto?.randomUUID) {
        return window.crypto.randomUUID();
      }

      return `id-${Date.now()}-${Math.random()
        .toString(36)
        .slice(2)}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function escapeAttr(value) {
      return escapeHtml(value);
    }
  </script>
</body>
</html>
